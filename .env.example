# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=researchmind
DATABASE_URL=postgresql+psycopg://researchmind:change-me@db:5432/researchmind

# --- LLM provider: ollama | gemini | openai_compat ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false
GEMINI_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Embeddings: ollama | sentence_transformers ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Reranker (model name, or "none") ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Scholarly APIs ---
CONTACT_EMAIL=            # used for the OpenAlex and Crossref polite pools
SEMANTIC_SCHOLAR_API_KEY= # optional, raises rate limits

# --- Agent budgets ---
AGENT_MAX_SUBQUESTIONS=5
AGENT_MAX_ROUNDS_PER_SUBQUESTION=3
AGENT_MAX_LLM_CALLS=40
AGENT_MAX_SECONDS=900

# --- Storage ---
DATA_DIR=/data
LOG_LEVEL=INFO
